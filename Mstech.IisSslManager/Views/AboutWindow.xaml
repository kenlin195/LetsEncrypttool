<Window x:Class="Mstech.IisSslManager.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="關於本軟體與使用聲明"
        Width="760"
        Height="720"
        MinWidth="680"
        MinHeight="560"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="White">
    <Window.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#24465F" />
        </Style>
        <Style x:Key="BodyTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="LineHeight" Value="23" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Grid Margin="30,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Image Width="510"
               Height="132"
               HorizontalAlignment="Center"
               Stretch="Uniform"
               Source="/Assets/mstech-logo.jpg"
               RenderOptions.BitmapScalingMode="HighQuality" />

        <StackPanel Grid.Row="1" Margin="0,8,0,18" HorizontalAlignment="Center">
            <TextBlock HorizontalAlignment="Center"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Text="MSTECH IIS SSL 自動更新工具" />
            <TextBlock Margin="0,7,0,0"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource MutedTextBrush}">
                <Run Text="版本：" /><Run Text="{Binding VersionText, Mode=OneWay}" />
            </TextBlock>
        </StackPanel>

        <Border Grid.Row="2"
                Background="#F7F9FB"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <ScrollViewer Padding="24,20"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="軟體說明" />
                    <TextBlock Style="{StaticResource BodyTextStyle}"
                               Text="本軟體由名世科技有限公司開發，旨在簡化 Microsoft IIS 環境中 Let’s Encrypt SSL/TLS 憑證的申請、安裝與更新流程，協助使用者更有效率地完成網站憑證設定與維護。" />

                    <Separator Margin="0,18" />

                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="無償使用聲明" />
                    <TextBlock Style="{StaticResource BodyTextStyle}">
                        <Run Text="本工具採無償方式提供，歡迎使用、轉載與分享。如有使用問題、錯誤回報或功能建議，歡迎來信至 " />
                        <Hyperlink Click="EmailHyperlink_OnClick">service@mstech.tw</Hyperlink>
                        <Run Text="。" />
                    </TextBlock>

                    <Border Margin="0,18,0,0"
                            Padding="16,14"
                            Background="#FFF7E8"
                            BorderBrush="#F0D39D"
                            BorderThickness="1"
                            CornerRadius="6">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleStyle}"
                                       Foreground="#8A5A00"
                                       Text="技術支援範圍" />
                            <TextBlock Style="{StaticResource BodyTextStyle}"
                                       Text="本軟體雖為無償提供，但免費服務範圍不包含遠端連線、伺服器環境設定、故障排除、客製化修改或其他技術支援。如有相關服務需求，請另行聯絡名世科技有限公司洽詢。" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,12,0,0"
                            Padding="16,14"
                            Background="#EEF6FB"
                            BorderBrush="#C7DEED"
                            BorderThickness="1"
                            CornerRadius="6">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="使用前提醒" />
                            <TextBlock Style="{StaticResource BodyTextStyle}"
                                       Text="使用本工具前，建議先備份 IIS 設定、既有憑證及相關系統設定，並由使用者自行確認操作環境與執行結果。" />
                        </StackPanel>
                    </Border>

                    <Separator Margin="0,18" />

                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="名世科技有限公司" />
                    <TextBlock Margin="0,0,0,12"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#47677C"
                               Text="您的資訊服務好夥伴" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="68" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Margin="0,4" Foreground="{StaticResource MutedTextBrush}" Text="地址" />
                        <TextBlock Grid.Column="1" Margin="0,4" Text="台中市太平區立德街 89 號" />

                        <TextBlock Grid.Row="1" Margin="0,4" Foreground="{StaticResource MutedTextBrush}" Text="電話" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,4" Text="04-2395-6110" />

                        <TextBlock Grid.Row="2" Margin="0,4" Foreground="{StaticResource MutedTextBrush}" Text="E-mail" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,4">
                            <Hyperlink Click="EmailHyperlink_OnClick">service@mstech.tw</Hyperlink>
                        </TextBlock>
                    </Grid>

                    <TextBlock Margin="0,20,0,2"
                               HorizontalAlignment="Center"
                               FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="© 2026 名世科技有限公司" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Button Grid.Row="3"
                Width="92"
                Margin="0,18,0,0"
                HorizontalAlignment="Right"
                IsDefault="True"
                IsCancel="True"
                Content="關閉" />
    </Grid>
</Window>
